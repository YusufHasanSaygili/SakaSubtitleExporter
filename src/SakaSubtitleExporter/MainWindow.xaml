<Window x:Class="SakaSubtitleExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saka Subtitle Exporter" Width="1160" Height="830" MinWidth="840" MinHeight="620"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/fish.ico"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#14181D"/>
        <SolidColorBrush x:Key="Surface" Color="#1C2229"/>
        <SolidColorBrush x:Key="Field" Color="#252D36"/>
        <SolidColorBrush x:Key="Line" Color="#39434F"/>
        <SolidColorBrush x:Key="Ink" Color="#F1F5F8"/>
        <SolidColorBrush x:Key="Muted" Color="#A9B6C4"/>
        <SolidColorBrush x:Key="Accent" Color="#73D5EB"/>
        <SolidColorBrush x:Key="AccentInk" Color="#10232B"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Field}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Box" CornerRadius="6" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <TextBlock Text="⌄" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,3"/>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="10,8,30,8" IsHitTestVisible="False" VerticalAlignment="Center"
                                      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                    <Border x:Name="FocusOutline" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="720" MaxHeight="340"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="3">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,20,28,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/fish.png" Width="64" Height="48" Margin="-5,0,12,0"/>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Saka" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Subtitle Exporter" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
            </StackPanel>
            <Button x:Name="ThemeButton" Content="Light theme" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleTheme" ToolTip="Switch between light and dark themes"/>
        </Grid>
        <Grid Grid.Row="1" Height="130" Margin="0,0,0,24" x:Name="DropArea">
            <Border Background="{DynamicResource Surface}" CornerRadius="10"/>
            <Rectangle Stroke="{DynamicResource Line}" StrokeDashArray="5 4" RadiusX="10" RadiusY="10" IsHitTestVisible="False"/>
            <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="30" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Drop MKV files here" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Add one episode or a whole season. Your files stay on your PC." Foreground="{DynamicResource Muted}" Margin="0,7,15,0" TextWrapping="Wrap"/></StackPanel>
                <Button Grid.Column="2" Content="Browse files" Click="BrowseFiles" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12" x:Name="QueueToolbar">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Episodes" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="FileCount" Text="0 files" Margin="12,4,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MatchButton" Content="Use first selection for all" Click="MatchAll" ToolTip="Match the first episode's primary track by language, title and codec. Ambiguous matches are left unchanged." Margin="0,0,8,0"/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearFiles"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock Text="Your episode list starts here" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Choose one subtitle per file, then add more only where you need them." Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <ListBox x:Name="EpisodeList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Remove" Padding="9,5" Click="RemoveFile" ToolTip="Remove this file from the queue"/>
                            </Grid>
                            <Grid Margin="0,14,0,0" Visibility="{Binding IsReady, Converter={StaticResource BoolVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding Selections}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Width="330" Margin="0,0,10,10">
                                            <Grid Margin="0,0,0,5"><TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                <Button Content="Remove" Click="RemoveSlot" Padding="5,0" FontSize="11" HorizontalAlignment="Right" Visibility="{Binding IsAdditional, Converter={StaticResource BoolVisibility}}" ToolTip="Remove this additional selection"/>
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding Owner.Tracks}" SelectedItem="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Caption}"
                                                      ToolTip="{Binding Selected.Label}" SelectionChanged="TrackSelectionChanged">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Content="+  Extract additional subtitle" Click="AddSlot" IsEnabled="{Binding CanAdd}" VerticalAlignment="Top" Margin="0,21,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,16,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Text="No subtitles selected" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Saved beside each MKV. Existing subtitles are kept." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,0" Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Click="CancelWork" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="2" x:Name="ExtractButton" Content="Extract selected" Style="{StaticResource PrimaryButton}" Click="ExtractSelected" VerticalAlignment="Center" Padding="23,12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
