<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>SakaSubtitleExporter</AssemblyName>
    <RootNamespace>SakaSubtitleExporter</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\fish.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Resource Include="..\..\assets\fish.png" Link="Assets\fish.png" />
    <Resource Include="..\..\assets\fish.ico" Link="Assets\fish.ico" />
  </ItemGroup>
</Project>
